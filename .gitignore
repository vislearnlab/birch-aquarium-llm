.env
# Secrets — NEVER commit. Mongo connection string with credentials.
mongo_auth.json
# Interaction logs (source of truth for the demo; may contain subject data).
data/sessions.jsonl
.venv/
__pycache__/
*.pyc
# data/raw/* (not data/raw/ — a directory-level ignore stops git from ever
# descending into it, which silently breaks the negation below) so scraper
# output stays untracked.
data/raw/*
# Exception: video-caption-*.md are hand-transcribed from birch-ask-v2's video
# stimuli, not scraper output — they can't be regenerated by re-running
# scrape/reference, so unlike the rest of data/raw/ they need to be committed.
!data/raw/video-caption-*.md
# data/index.npz is committed as a prebuilt snapshot so the demo runs on a fresh
# clone with no scrape/ingest. Rebuild + recommit it after changing the corpus.
.DS_Store
